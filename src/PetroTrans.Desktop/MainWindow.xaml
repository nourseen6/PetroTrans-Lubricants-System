<Window x:Class="PetroTrans.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Petro Trans 1.0.1"
        Icon="Assets/logo-petrotrans.png"
        Width="1120"
        Height="720"
        MinWidth="640"
        MinHeight="480"
        WindowState="Normal"
        FlowDirection="LeftToRight"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded"
        Closing="OnClosing">
  <Grid>
    <TextBlock x:Name="StatusText"
               Margin="24"
               FontSize="18"
               Text="جاري تشغيل بترو ترانس…" />
    <wv2:WebView2 x:Name="WebView" Visibility="Collapsed" />
  </Grid>
</Window>
